<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later read this instead of android:allowBackup. Nothing
     the app stores is eligible: the database is a cache of two cloud
     accounts and rebuilds itself on the first sync, and the credentials are
     encrypted against key material that does not leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
